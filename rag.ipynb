    "def evaluate_retrieval(questions, k=5):\n",
    "    hits = 0\n",
    "    reciprocal_ranks = []\n",
    "\n",
    "    for item in questions:\n",
    "        retriever = QdrantMotorsportsRetriever(top_k=k)\n",
    "        docs = retriever.invoke(item[\"question\"])\n",
    "        retrieved_sources = [d.metadata[\"source_url\"] for d in docs]\n",
    "\n",
    "        rank = None\n",
    "        for i, src in enumerate(retrieved_sources):\n",
    "            if any(exp in src for exp in item[\"expected_sources\"]):\n",
    "                rank = i + 1\n",
    "                break\n",
    "\n",
    "        if rank:\n",
    "            hits += 1\n",
    "            reciprocal_ranks.append(1 / rank)\n",
    "        else:\n",
    "            reciprocal_ranks.append(0.0)\n",
    "\n",
    "    return {\n",
    "        \"k\": k,\n",
    "        \"n_questions\": len(questions),\n",
    "        \"hit_rate\": round(hits / len(questions), 3),\n",
    "        \"mrr\": round(sum(reciprocal_ranks) / len(reciprocal_ranks), 3)\n",
    "    }"
   ]
  },
