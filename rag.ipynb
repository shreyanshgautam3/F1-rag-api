    "# Scraping Wikipedia Links\n",
    "\n",
    "text_content = []\n",
    "\n",
    "wiki_urls = Path(r\"location_to_doc")\n",
    "DROP_SECTIONS = {\"See also\", \"Reference\", \"External Links\", \"Notes\", \"Further reading\"}\n",
    "\n",
    "def extract_title_from_url(url):\n",
    "    match = re.search(r\"wiki/([^#\\?]+)\", url)\n",
    "    if match:\n",
    "        return urllib.parse.unquote(match.group(1)).replace(\"_\", \" \")\n",
    "    return None\n",
    "\n",
    "def page_to_markdown(page):\n",
    "    md = [f\"# {page.title}\\n\\n{page.summary.strip()}\\n\"]\n",
    "\n",
    "    def walk(sections, level):\n",
    "        for s in sections:\n",
    "            if s.title in DROP_SECTIONS:\n",
    "                continue\n",
    "\n",
    "            if s.text.strip():\n",
    "                md.append(f\"{'#' * level} {s.title}\\n\\n{s.text.strip()}\\n\")\n",
    "            walk(s.sections, level + 1)\n",
    "    walk(page.sections, 2)\n",
    "    return \"\\n\".join(md)\n",
    "\n",
    "def wiki_extraction():\n",
    "    section = None\n",
    "\n",
    "    with open(wiki_urls, \"r\", encoding=\"utf-8\") as f:\n",
    "        for line in f:\n",
    "            line = line.strip()\n",
    "            if not line:\n",
    "                continue\n",
    "\n",
    "            if line.startswith(\"#\"):\n",
    "                section = line.lstrip(\"#\").strip()\n",
    "                continue\n",
    "\n",
    "            url = line\n",
    "            clean_title = extract_title_from_url(url)\n",
    "\n",
    "            try:\n",
    "                page = wiki_client.page(clean_title)\n",
    "\n",
    "                if page.exists():\n",
    "                    text_content.append({\n",
    "                        \"text\": page_to_markdown(page),\n",
    "                        \"source\": url,\n",
    "                        \"section\": section,\n",
    "                        \"doc_type\": \"wikipedia\",\n",
    "                    }\n",
    "                )\n",
    "\n",
    "            except Exception as e:\n",
    "                print(f\"Failed scraping {clean_title} from [{url}]: {e}\")\n",
    "\n",
    "            time.sleep(0.5)\n",
    "    print(f\"{len(text_content)} wikipedias scraped\")"
   ]
  },
