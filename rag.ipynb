    "# Generating embeddings and upserting to Qdrant\n",
    "\n",
    "if qdrant_client.collection_exists(collection_name=collection_name):\n",
    "    qdrant_client.delete_collection(collection_name=collection_name)\n",
    "\n",
    "qdrant_client.create_collection(\n",
    "    collection_name=collection_name,\n",
    "    vectors_config=models.VectorParams(\n",
    "        size=embed_dim,\n",
    "        distance=models.Distance.COSINE)\n",
    ")\n",
    "\n",
    "def make_point_id(chunk_id):\n",
    "    return hashlib.md5(chunk_id.encode()).hexdigest()\n",
    "\n",
    "batch_size = 1000\n",
    "\n",
    "for i in range(0, len(all_chunks), batch_size):\n",
    "    batch = all_chunks[i : i + batch_size]\n",
    "    texts = [c[\"text\"] for c in batch]\n",
    "\n",
    "    result = voyageai_client.embed(texts, model=voyage_model, input_type=\"document\")\n",
    "\n",
    "    points = [\n",
    "        models.PointStruct(\n",
    "            id=make_point_id(c[\"chunk_id\"]),\n",
    "            vector=emb,\n",
    "            payload={\n",
    "                \"text\": c[\"text\"],\n",
    "                \"source_url\": c[\"source\"],\n",
    "                \"section\": c[\"section\"],\n",
    "                \"doc_type\": c[\"doc_type\"],\n",
    "            },\n",
    "        )\n",
    "        for c, emb in zip(batch, result.embeddings)\n",
    "    ]\n",
    "\n",
    "    qdrant_client.upsert(\n",
    "        collection_name=collection_name,\n",
    "        points=points\n",
    "    )\n",
    "    print(f\"batch {i // batch_size + 1}: embedded + upserted {len(points)} chunks\")\n",
    "    time.sleep(0.2)"
   ]
  },
