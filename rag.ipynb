    "# Tokenizing and Chunking functions\n",
    "\n",
    "enc = tiktoken.get_encoding(\"cl100k_base\")\n",
    "\n",
    "def token_len(text):\n",
    "    return len(enc.encode(text))\n",
    "\n",
    "header_splitter = MarkdownHeaderTextSplitter(\n",
    "    headers_to_split_on=[(\"#\", \"h1\"), (\"##\", \"h2\"), (\"###\", \"h3\")]\n",
    ")\n",
    "\n",
    "wiki_token_splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=500,\n",
    "    chunk_overlap=80,\n",
    "    length_function=token_len,\n",
    ")\n",
    "\n",
    "# Wikipedia chunking function\n",
    "\n",
    "def chunk_article(md_text):\n",
    "    header_chunks = header_splitter.split_text(md_text)\n",
    "    final_chunks = []\n",
    "    for hc in header_chunks:\n",
    "        if token_len(hc.page_content) <= 80:\n",
    "            final_chunks.append(hc.page_content)\n",
    "        else:\n",
    "            final_chunks.extend(wiki_token_splitter.split_text(hc.page_content))\n",
    "    return final_chunks\n",
    "\n",
    "# PDFs chunking function\n",
    "\n",
    "pdf_splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=280,\n",
    "    chunk_overlap=40,\n",
    "    length_function=token_len,\n",
    ")\n",
    "\n",
    "def strip_boilerplate(text, min_repeat=5, max_len=90):\n",
    "    lines = text.split(\"\\n\")\n",
    "    counts = Counter(l.strip() for l in lines if l.strip())\n",
    "    boilerplate = {l for l, c in counts.items() if c >= min_repeat and len(l) <= max_len}\n",
    "    page_marker = re.compile(r\"^[A-Z]{1,2}\\d{1,4}$\")\n",
    "    cleaned = [l for l in lines if l.strip() not in boilerplate and not page_marker.match(l.strip())]\n",
    "    return \"\\n\".join(cleaned)"
   ]
  },
