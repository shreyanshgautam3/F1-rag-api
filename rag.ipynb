    "# Chunking\n",
    "\n",
    "def chunk_pdf(text):\n",
    "    text = strip_boilerplate(text)\n",
    "    return pdf_splitter.split_text(text)\n",
    "\n",
    "def chunk_documents(text_content):\n",
    "    all_chunks = []\n",
    "    for doc in text_content:\n",
    "        if doc[\"doc_type\"] == \"wikipedia\":\n",
    "            texts = chunk_article(doc[\"text\"])\n",
    "        elif doc[\"doc_type\"] == \"pdf\":\n",
    "            texts = chunk_pdf(doc[\"text\"])\n",
    "        else:\n",
    "            continue\n",
    "\n",
    "        for i, t in enumerate(texts):\n",
    "            all_chunks.append({\n",
    "                \"text\": t,\n",
    "                \"source\": doc[\"source\"],\n",
    "                \"section\": doc[\"section\"],\n",
    "                \"doc_type\": doc[\"doc_type\"],\n",
    "                \"chunk_id\": f\"{doc['source']}#{i}\",\n",
    "            })\n",
    "\n",
    "    return all_chunks\n",
    "\n",
    "all_chunks = chunk_documents(text_content)\n",
    "print(f\"Total Chunks: {len(all_chunks)}\")"
   ]
  },
