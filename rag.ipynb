    "# Loading PDFs\n",
    "\n",
    "pdf_path = Path(r\"location_to_pdfs")\n",
    "pdf_search = pdf_path.rglob(\"*.pdf\")\n",
    "pdf_files = list(pdf_search)\n",
    "\n",
    "for pdf in pdf_files:\n",
    "    reader = PdfReader(pdf)\n",
    "    pdf_text = \"\"\n",
    "\n",
    "    for page in reader.pages:\n",
    "        text = page.extract_text()\n",
    "        if text:\n",
    "            pdf_text += text + \"\\n\"\n",
    "\n",
    "    if pdf_text.strip():\n",
    "        text_content.append({\n",
    "            \"text\": pdf_text,\n",
    "            \"source\": pdf.name,\n",
    "            \"section\": pdf.stem,\n",
    "            \"doc_type\": \"pdf\",\n",
    "        })\n",
    "\n",
    "print(f\"{len(pdf_files)} PDFs loaded\")"
   ]
